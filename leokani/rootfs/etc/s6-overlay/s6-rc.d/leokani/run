#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Start the Leokani Wyoming server
# ==============================================================================

# The voice the Model option picks (Leokani-tts 7M when unset, as in 1.1).
model_dir() {
    case "$(bashio::config 'model' 'Leokani-tts 7M')" in
        "Leokani-tts 4.5M") echo /opt/leokani/model-4.5M ;;
        *) echo /opt/leokani/model ;;
    esac
}

flags=(--port 10200 --model-dir "$(model_dir)" --speed "$(bashio::config 'speed')")

if bashio::config.true 'debug_logging'; then
    flags+=(--debug)
fi

exec python3 -m leokani_server wyoming "${flags[@]}"
